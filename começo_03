CREATE TABLE carnes_artesanais (
ID INTEGER PRIMARY KEY ,
tipo VARCHAR(20) NOT NULL,           
sabor_carne VARCHAR(20) NOT NULL,           
recheio VARCHAR(20) ,             
quantidade int ,  
preço_unitario DECIMAL (6, 2) NOT NULL,
peso_unitario FLOAT NOT NULL ,
espessura VARCHAR(20)
);

